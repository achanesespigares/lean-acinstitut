{"codigo":"import Mathlib\n\ndef Continua (f : ℝ → ℝ) (a : ℝ) : Prop :=\n  ∀ ε > 0, ∃ δ > 0, ∀ x, |x - a| < δ → |f x - f a| < ε\n\nexample (a : ℝ) : Continua (fun x => x ^ 2) a := by\n  intro ε hε\n  refine ⟨min 1 (ε / (2 * |a| + 1)), by positivity, ?_⟩\n  intro x hx\n  have h1 : |x - a| < 1 := lt_of_lt_of_le hx (min_le_left _ _)\n  have h2 : |x - a| < ε / (2 * |a| + 1) := lt_of_lt_of_le hx (min_le_right _ _)\n  have h3 : |x + a| ≤ 2 * |a| + 1 := by\n    calc |x + a| = |(x - a) + 2 * a| := by ring_nf\n      _ ≤ |x - a| + |2 * a| := abs_add_le _ _\n      _ ≤ 1 + 2 * |a| := by rw [abs_mul]; norm_num; linarith\n      _ = 2 * |a| + 1 := by ring\n  dsimp only\n  rw [show x ^ 2 - a ^ 2 = (x - a) * (x + a) by ring, abs_mul]\n  calc |x - a| * |x + a| ≤ |x - a| * (2 * |a| + 1) := by gcongr\n    _ < ε / (2 * |a| + 1) * (2 * |a| + 1) := by gcongr\n    _ = ε := by field_simp\n","focos":[{"col":49,"colFin":26,"despues":[],"linea":6,"lineaFin":21},{"col":49,"colFin":51,"despues":[],"linea":6,"lineaFin":6},{"col":2,"colFin":26,"despues":[],"linea":7,"lineaFin":21},{"col":2,"colFin":12,"despues":["a ε : ℝ\nhε : ε > 0\n⊢ ∃ δ > 0, ∀ (x : ℝ), |x - a| < δ → |(fun x => x ^ 2) x - (fun x => x ^ 2) a| < ε"],"linea":7,"lineaFin":7},{"col":2,"colFin":9,"despues":["a ε : ℝ\n⊢ ε > 0 → ∃ δ > 0, ∀ (x : ℝ), |x - a| < δ → |(fun x => x ^ 2) x - (fun x => x ^ 2) a| < ε"],"linea":7,"lineaFin":7},{"col":10,"colFin":12,"despues":["a ε : ℝ\nhε : ε > 0\n⊢ ∃ δ > 0, ∀ (x : ℝ), |x - a| < δ → |(fun x => x ^ 2) x - (fun x => x ^ 2) a| < ε"],"linea":7,"lineaFin":7},{"col":2,"colFin":55,"despues":["a ε : ℝ\nhε : ε > 0\n⊢ ∀ (x : ℝ), |x - a| < min 1 (ε / (2 * |a| + 1)) → |(fun x => x ^ 2) x - (fun x => x ^ 2) a| < ε"],"linea":8,"lineaFin":8},{"col":37,"colFin":50,"despues":[],"linea":8,"lineaFin":8},{"col":37,"colFin":39,"despues":[],"linea":8,"lineaFin":8},{"col":40,"colFin":50,"despues":[],"linea":8,"lineaFin":8},{"col":2,"colFin":12,"despues":["a ε : ℝ\nhε : ε > 0\nx : ℝ\nhx : |x - a| < min 1 (ε / (2 * |a| + 